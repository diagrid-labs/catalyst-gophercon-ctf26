# Copy to deploy/.env and fill in real values. NEVER commit deploy/.env.

# Runtime profile: dev (fake fixtures, default token) or prod (real flags, token required).
PARK_PROFILE=prod

# Path to the flags JSON with real values. Mounted into the container by
# docker-compose from deploy/secrets/flags.json — provisioned out of band, never
# baked into the image or committed to git.
PARK_FLAGS_FILE=/etc/park-systems/flags.json

# Shared bearer token participants set in their Catalyst MCPServer auth header.
# REQUIRED in the prod profile. Use a long random value.
PARK_BEARER_TOKEN=replace-with-a-long-random-token

# Per-source-IP request cap per minute (blunts brute force of the bootstrap code).
PARK_RATE_PER_MIN=30
